# Copy to .env only if you need to change something. A shop install needs none
# of these: secrets are generated into instance/ on first start.

# development = local coding (Flask debug, demo data allowed).
# Leave unset for the shop; `run.py --lan` always runs in production mode.
FLASK_ENV=development

# Shop timezone used until the owner sets one in Settings.
BUSINESS_TIMEZONE=Africa/Nairobi

# Only for special cases:
# DATABASE_URL=sqlite:///pos.db          (default: server/instance/pos.db)
# LAN_URL=http://192.168.1.20:8080       (if the detected address is wrong)
# BACKUP_DIR=/Volumes/USB/pos-backups
# SECRET_KEY=... JWT_SECRET_KEY=...      (32+ random characters each)

# Hosted (cloud) mode only:
# POS_MODE=cloud
# DATABASE_URL=postgresql://...
# CORS_ORIGINS=https://your-frontend.example
# TRUSTED_PROXY_COUNT=1
