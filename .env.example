# Local development. Anything other than FLASK_ENV=development/testing is treated
# as production and refuses to start without real secrets and PostgreSQL.
FLASK_ENV=development

# Production: random values of 32+ characters each, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me

# Production: your PostgreSQL URL (postgres:// and postgresql:// both work).
DATABASE_URL=sqlite:///pos.db

# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Shop timezone for "today", date filters and daily trends.
BUSINESS_TIMEZONE=Africa/Nairobi

# Reverse proxies in front of the API (1 on Render, 0 locally).
TRUSTED_PROXY_COUNT=0
